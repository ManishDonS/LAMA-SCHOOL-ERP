# Environment (development, production, test)
ENVIRONMENT=development

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=school_erp
DB_USER=postgres
DB_PASSWORD=CHANGE_IN_PRODUCTION

# Database SSL Mode (disable, prefer, require, verify-ca, verify-full)
# Development: prefer (use SSL if available, fallback to non-SSL)
# Production: require (enforce SSL)
# Testing: disable (for local testing only)
DB_SSL_MODE=prefer

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# NATS Configuration
NATS_URL=nats://nats:4222

# JWT Configuration
JWT_SECRET=dev-secret-key-change-in-production
REFRESH_TOKEN_SECRET=dev-refresh-secret-key-change-in-production
JWT_EXPIRY=24h

# Docker Registry
REGISTRY=localhost:5000

# Super Admin Configuration (IMPORTANT: Change these in production!)
SUPER_ADMIN_EMAIL=admin@school.com
SUPER_ADMIN_PASSWORD=Admin@1234

# Encryption Configuration (REQUIRED for production)
ENCRYPTION_KEY=change-this-to-a-32-byte-random-key-in-production

# Service Ports
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
STUDENT_SERVICE_PORT=3003
ATTENDANCE_SERVICE_PORT=3004
FEE_SERVICE_PORT=3005
EXAM_SERVICE_PORT=3006
NOTIFICATION_SERVICE_PORT=3007
REALTIME_SERVICE_PORT=3008
TRANSPORT_SERVICE_PORT=3009
EXPENSE_SERVICE_PORT=3010
SCHOOL_SERVICE_PORT=3011
PAYROLL_SERVICE_PORT=3012
WEBSITE_SERVICE_PORT=3013
COMMUNICATION_SERVICE_PORT=8005
ACCOUNTING_SERVICE_PORT=8009

# CORS Configuration
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001

# API Gateway
API_GATEWAY_PORT=3000

# Transport Service - Traccar Integration
TRACCAR_API_URL=https://system.geotrack.com.np/api
TRACCAR_USER=admin
TRACCAR_PASSWORD=change-in-production

# Website Service - AI Integration (Optional)
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Redis Configuration
REDIS_PORT=6380

# NATS Configuration
NATS_PORT=4223

# Security Note:
# ============================================================================
# CRITICAL: For production deployment, you MUST:
# ============================================================================
#
# 1. Set ENVIRONMENT=production
#
# 2. Change ALL default passwords and secrets:
#    - DB_PASSWORD (use a strong, unique password)
#    - SUPER_ADMIN_PASSWORD (minimum 12 characters, mix of upper/lower/numbers/symbols)
#    - TRACCAR_PASSWORD
#
# 3. Generate cryptographically secure secrets:
#    JWT_SECRET=$(openssl rand -base64 64)
#    REFRESH_TOKEN_SECRET=$(openssl rand -base64 64)
#    ENCRYPTION_KEY=$(openssl rand -hex 32)
#
#    Note: ENCRYPTION_KEY is REQUIRED - service will not start without it
#
# 4. Enable SSL for database connections:
#    DB_SSL_MODE=require (or verify-full for maximum security)
#
# 5. Configure CORS for your production domain:
#    CORS_ALLOW_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
#    (Never use http:// or wildcards in production)
#
# 6. Never commit .env file to version control:
#    - .env is already in .gitignore
#    - Use environment variables or secrets management (Kubernetes secrets, AWS Secrets Manager, etc.)
#
# 7. Rotate secrets regularly:
#    - JWT secrets: every 90 days
#    - Encryption key: only if compromised (requires re-encryption of existing data)
#    - Database passwords: every 90 days
#
# 8. Review SECURITY.md for complete security guidelines
#
# ============================================================================
